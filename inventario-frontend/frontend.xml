<div class="custom-modal-container">

  <!-- CABECERA CORPORATIVA -->
  <div class="header-modal p-4 text-white d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center gap-3">
      <div class="icon-circle bg-white-20">
        <mat-icon>history</mat-icon>
      </div>
      <div>
        <h5 class="m-0 fw-bold">Historial: {{ data.equipo.nombreProducto }}</h5>
        <small class="opacity-75">
          Serie: {{ data.equipo.serieProducto || 'S/N' }} |
          Inv: {{ data.equipo.inventarioProducto || 'S/I' }} |
          {{ data.equipo.marca || 'SIN MARCA' }} {{ data.equipo.modelo || 'SIN MODELO' }}
        </small>
      </div>
    </div>
    <button mat-icon-button class="text-white" (click)="dialogRef.close()">
      <mat-icon>close</mat-icon>
    </button>
  </div>

  <mat-dialog-content class="p-4 dialog-content-scroll">

    <!-- RESUMEN INFORMATIVO SUPERIOR -->
    <div class="d-flex flex-wrap justify-content-between align-items-center bg-light p-3 rounded-3 mb-4 border">
      <div class="d-flex align-items-center gap-3">
        <span class="text-secondary small fw-bold text-uppercase">Total Movimientos:</span>
        <span class="badge-pill bg-white text-dark shadow-sm border fw-bold">{{ data.historial.length }}</span>
      </div>
      <div class="d-flex align-items-center gap-2">
        <span class="text-secondary small fw-bold text-uppercase">Estado Actual:</span>
        <span class="badge-pill-status" [ngClass]="data.equipo.estadoActual === 'ASIGNADO' ? 'status-asignado' : 'status-devuelto'">
          {{ data.equipo.estadoActual }}
        </span>
      </div>
    </div>

    <!-- TARJETAS HORIZONTALES CON SCROLL -->
    <div class="d-flex gap-3 overflow-auto py-2 timeline-scroll">
      @for (item of data.historial; track item.idAsignacion) {
        <div class="timeline-step p-3 rounded-4 border bg-white shadow-sm d-flex flex-column justify-content-between"
             [ngClass]="item.estadoDetalle === 'ASIGNADO' ? 'card-asignado' : 'card-devuelto'">

          <!-- CABECERA: ACTA Y ESTADO -->
          <div>
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="badge-soft badge-acta-gris">
                <mat-icon class="icon-tiny me-1">description</mat-icon>Acta {{ item.numeroActa }}
              </span>

              <span class="badge-pill-status"
                    [ngClass]="item.estadoDetalle === 'ASIGNADO' ? 'status-asignado' : 'status-devuelto'">
                {{ item.estadoDetalle }}
              </span>
            </div>

            <!-- DETALLES DE UBICACIÓN Y RESPONSABLE -->
            <div class="mb-2">
              <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.68rem; letter-spacing: 0.5px;">
                Ubicación / Responsable
              </small>
              <div class="fw-bold text-dark text-truncate d-flex align-items-center gap-1 mt-1" style="font-size: 0.9rem;" [matTooltip]="item.nombreUbicacion || ''">
                <mat-icon class="icon-tiny text-primary flex-shrink-0">place</mat-icon>
                <span class="text-truncate">{{ item.nombreUbicacion || 'Sin ubicación' }}</span>
              </div>
              @if (item.responsableDestino) {
                <small class="text-secondary d-flex align-items-center gap-1 mt-1 text-truncate" style="font-size: 0.8rem;" [matTooltip]="item.responsableDestino">
                  <mat-icon class="icon-tiny text-muted flex-shrink-0">person</mat-icon>
                  <span class="text-truncate">{{ item.responsableDestino }}</span>
                </small>
              }
            </div>

            <div class="d-flex align-items-center justify-content-between text-muted mb-2 pb-2 border-bottom" style="font-size: 0.78rem;">
              <span><mat-icon class="icon-tiny align-middle me-1 text-secondary">category</mat-icon>{{ item.tipoAsignacion }}</span>
              <span><mat-icon class="icon-tiny align-middle me-1 text-secondary">event</mat-icon>{{ item.fechaAsignacion | date:'dd/MM/yyyy h:mm a' }}</span>
            </div>
          </div>

          <!-- BLOQUE DE RETORNO O POSESIÓN -->
          @if (item.fechaDevolucion) {
            <div class="devolucion-box p-2 rounded-3 mt-2">
              <div class="d-flex align-items-center gap-1 text-success fw-bold mb-1" style="font-size: 0.75rem;">
                <mat-icon class="icon-tiny">check_circle</mat-icon>
                <span>Reingresado a Bodega</span>
              </div>
              <small class="text-muted d-block" style="font-size: 0.74rem;">
                <strong>Fecha:</strong> {{ item.fechaDevolucion | date:'dd/MM/yyyy h:mm a' }}
              </small>
              <small class="text-muted d-block text-truncate" style="font-size: 0.74rem;">
                <strong>Bodega:</strong> {{ item.bodegaDevolucion || 'No especificada' }}
              </small>
              @if (item.observacionDevolucion) {
                <small class="text-secondary fst-italic d-block mt-1 text-truncate" style="font-size: 0.72rem;">
                  "{{ item.observacionDevolucion }}"
                </small>
              }
            </div>
          } @else {
            <div class="posesion-box p-2 rounded-3 mt-2 d-flex align-items-center gap-2">
              <span class="status-pulse-dot"></span>
              <span class="fw-bold text-primary" style="font-size: 0.78rem;">Actualmente en posesión</span>
            </div>
          }

        </div>
      } @empty {
        <div class="w-100 text-center py-5 text-muted">
          <mat-icon class="opacity-50" style="font-size: 40px; width: 40px; height: 40px;">history_toggle_off</mat-icon>
          <p class="mt-2 mb-0">No se encontraron movimientos aprobados para este equipo.</p>
        </div>
      }
    </div>

  </mat-dialog-content>

  <mat-dialog-actions align="end" class="p-3 border-top bg-light">
    <button mat-button class="btn-cancel px-4 rounded-pill" (click)="dialogRef.close()">Cerrar</button>
  </mat-dialog-actions>
</div>
</file>

