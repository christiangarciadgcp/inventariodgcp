<div class="container-wide px-5 mt-4 mb-5">

  <div class="d-flex justify-content-between align-items-center mb-3 gap-3 px-2">
    <div class="d-flex align-items-center gap-3">
      <button mat-icon-button class="bg-white shadow-sm text-dark" routerLink="/dashboard">
        <mat-icon style="margin-bottom: 5px;">arrow_back</mat-icon>
      </button>
      <div>
        <h6 class="text-uppercase text-muted mb-1" style="font-size: 0.8rem; letter-spacing: 1px;">Control de Activos</h6>
        <h2 class="fw-bold text-dark m-0">Trazabilidad de Equipos Informáticos</h2>
      </div>
    </div>

    <div class="search-elegant m-0" style="width: 320px;">
      <input type="text" class="search-input" (keyup)="applyFilter($event)" placeholder="Buscar..." autocomplete="off">
      <div class="search-btn-circle"><mat-icon>search</mat-icon></div>
    </div>
  </div>

  <mat-card class="custom-card mb-5">
    @if (cargando()) {
      <div class="d-flex flex-column justify-content-center align-items-center py-5">
        <mat-spinner diameter="50" strokeWidth="5" color="primary"></mat-spinner>
        <h6 class="mt-2 text-dark fw-bold m-0" style="letter-spacing: 1px;">Cargando trazabilidad...</h6>
      </div>
    } @else {
      <table mat-table [dataSource]="dataSource" matSort class="w-100">

        <!-- FECHA ÚLTIMA ASIGNACIÓN -->
        <ng-container matColumnDef="fecha">
          <th mat-header-cell *matHeaderCellDef mat-sort-header class="text-center"> ÚLTIMA ASIGNACIÓN </th>
          <td mat-cell *matCellDef="let element" class="text-center py-2 text-muted">
            <span class="text-dark fw-medium d-block" style="font-size: 0.85rem;">
              {{ element.fechaUltimaAsignacion ? (element.fechaUltimaAsignacion | date:'dd/MM/yyyy') : 'N/A' }}
            </span>
          </td>
        </ng-container>


        <!-- EQUIPO INFORMÁTICO -->
        <ng-container matColumnDef="producto">
          <th mat-header-cell *matHeaderCellDef mat-sort-header class="text-center"> EQUIPO INFORMÁTICO </th>
          <td mat-cell *matCellDef="let element" class="text-center py-2 fw-bold text-dark">
            {{ element.nombreProducto }}
          </td>
        </ng-container>

        <!-- MARCA / MODELO  -->
        <ng-container matColumnDef="marca-modelo">
          <th mat-header-cell *matHeaderCellDef mat-sort-header class="text-center"> MARCA / MODELO </th>
          <td mat-cell *matCellDef="let element" class="text-center py-2">
            <div class="d-flex flex-column align-items-center justify-content-center">
              <span class="fw-bold text-dark">{{ element.marca || 'SIN MARCA' }}</span>
              <small class="text-secondary mt-1">{{ element.modelo || 'SIN MODELO' }}</small>
            </div>
          </td>
        </ng-container>

        <!-- SERIE / INVENTARIO  -->
        <ng-container matColumnDef="serie-inventario">
          <th mat-header-cell *matHeaderCellDef mat-sort-header class="text-center"> SERIE / INVENTARIO </th>
          <td mat-cell *matCellDef="let element" class="text-center py-2 font-monospace">
            @if (element.serieProducto || element.inventarioProducto) {
              <span class="fw-bold text-dark d-block"> {{ element.serieProducto || 'S/N' }}</span>
              <small class="text-secondary d-block mt-1"> {{ element.inventarioProducto || 'S/I' }}</small>
            } @else {
              <span class="text-muted small">S/N - S/I</span>
            }
          </td>
        </ng-container>

        <!-- UBICACIÓN / RESPONSABLE -->
        <ng-container matColumnDef="ubicacion">
          <th mat-header-cell *matHeaderCellDef mat-sort-header class="text-center"> UBICACIÓN / RESPONSABLE </th>
          <td mat-cell *matCellDef="let element" class="text-center py-2">
            <div class="fw-bold text-dark">
              {{ element.nombreUbicacion || 'Sin ubicación' }}
            </div>
            @if (element.asignadoA) {
              <small class="text-muted d-block mt-1">
                <mat-icon style="font-size: 13px; width: 13px; height: 13px; vertical-align: middle;">person</mat-icon>
                {{ element.asignadoA }}
              </small>
            }
          </td>
        </ng-container>

        <!-- ESTADO ACTUAL -->
        <ng-container matColumnDef="estado">
          <th mat-header-cell *matHeaderCellDef mat-sort-header class="text-center"> ESTADO ACTUAL </th>
          <td mat-cell *matCellDef="let element" class="text-center py-2">
            <span class="badge-soft" [ngClass]="element.estadoActual === 'ASIGNADO' ? 'estado-asignada' : 'estado-devolucion-total'">
              {{ element.estadoActual }}
            </span>
          </td>
        </ng-container>



        <!-- ACCIONES -->
        <ng-container matColumnDef="acciones">
          <th mat-header-cell *matHeaderCellDef class="text-center pe-4"> HISTORIAL </th>
          <td mat-cell *matCellDef="let element" class="text-center pe-4 py-2 col-acciones">
            <button mat-icon-button color="primary" matTooltip="Ver historial completo" (click)="verTimeline(element)">
              <mat-icon>history</mat-icon>
            </button>
          </td>
        </ng-container>

        <tr mat-header-row *matHeaderRowDef="displayedColumns"></tr>
        <tr mat-row *matRowDef="let row; columns: displayedColumns;" class="hover-row"></tr>

        <tr class="mat-row" *matNoDataRow>
          <td class="mat-cell text-center py-5 text-muted" colspan="6">
            <div class="d-flex flex-column align-items-center justify-content-center text-muted">
              <mat-icon style="font-size: 40px; width: 40px; height: 40px;" class="mb-2">devices_other</mat-icon>
              <p class="m-0">No hay equipos con registros de asignación.</p>
            </div>
          </td>
        </tr>
      </table>
    }
    <mat-paginator [pageSizeOptions]="[25, 50, 100]" showFirstLastButtons></mat-paginator>
  </mat-card>
</div>
</file>

