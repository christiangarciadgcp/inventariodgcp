  border-radius: 50px;
  display: inline-flex;
  align-items: center;
  transition: all 0.25s ease-in-out;
  box-shadow: 0 2px 5px rgba(0, 0, 0, 0.03);
  cursor: pointer;
  user-select: none;
}

.tab-pill-btn:hover {
