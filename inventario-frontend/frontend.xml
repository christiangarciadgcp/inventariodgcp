<file path="src/app/components/asignacion/asignacion-form/asignacion-form.component.html">
<div class="container-wide px-4 mt-4 mb-5">

  <div class="d-flex align-items-center gap-3 mb-4">
    <button mat-icon-button class="bg-white shadow-sm text-secondary" routerLink="/asignaciones">
      <mat-icon style="margin-bottom: 5px;">arrow_back</mat-icon>
    </button>

    <div>
      <h6 class="text-uppercase text-muted mb-0" style="font-size: 0.75rem; letter-spacing: 1px;">Gestión de Asignaciones</h6>
      <h3 class="fw-bold m-0 text-dark">
        {{ esEdicion() ? 'Editar Asignación (Acta N° ' + numeroActa() + ')' : 'Nueva Asignación de Equipos' }}
      </h3>
    </div>
  </div>

  <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
    <div class="header-brand p-4 text-white d-flex align-items-center gap-3">
      <div class="icon-circle bg-white-20">
        <mat-icon>assignment_add</mat-icon>
      </div>
      <div>
        <h5 class="m-0 fw-bold">Registro de Asignación</h5>
        <small class="opacity-75">El acta se generará correlativamente y se descargará del inventario tras la aprobación de Jefatura</small>
      </div>
    </div>

    <div class="card-body p-4 bg-white">
      <form [formGroup]="form">

        <h6 class="text-muted fw-bold mb-3 small text-uppercase" style="letter-spacing: 1px;">Datos de Destino</h6>

        <div class="p-4 rounded-3 mb-4 border border-dashed bg-light">
          <div class="row g-3">

            <!-- TIPO DE MOVIMIENTO -->
            <div class="col-md-2">
              <label class="form-label small fw-bold text-muted">Tipo de Movimiento *</label>
              <mat-form-field appearance="outline" class="w-100" subscriptSizing="dynamic">
                <mat-label>Seleccione Tipo</mat-label>
                <mat-select formControlName="idAsignacionTipo">
                  @for (t of tiposAsignacion(); track t.idAsignacionTipo) {
                    <mat-option [value]="t.idAsignacionTipo">{{ t.nombre }}</mat-option>
                  }
                </mat-select>
              </mat-form-field>
              @if (form.get('idAsignacionTipo')?.touched && form.get('idAsignacionTipo')?.hasError('required')) {
                <small class="text-danger">El tipo es obligatorio</small>
              }
            </div>

            <!-- UBICACIÓN DESTINO -->
            <div class="col-md-7">
              <label class="form-label small fw-bold text-muted">Ubicación Destino *</label>
              <mat-form-field appearance="outline" class="w-100" subscriptSizing="dynamic">
                <mat-label>Seleccione o escriba ubicación...</mat-label>
                <input type="text"
                       matInput
                       #triggerUbicacion="matAutocompleteTrigger"
                       [formControl]="ubicacionFiltroCtrl"
                       [matAutocomplete]="autoUbicacion"
                       placeholder="Buscar por nombre o siglas..."
                       (focus)="abrirUbicaciones(triggerUbicacion)"
                       (click)="abrirUbicaciones(triggerUbicacion)"
                       autocomplete="off">

                <!-- BOTÓN LIMPIAR -->
                @if (form.get('idUbicacion')?.value || ubicacionFiltroCtrl.value) {
                  <button matSuffix mat-icon-button type="button" aria-label="Limpiar ubicación" (click)="limpiarUbicacion()" matTooltip="Limpiar selección">
                    <mat-icon style="font-size: 18px; width: 18px; height: 18px;">close</mat-icon>
                  </button>
                }

                <!-- FLECHA DROPDOWN -->
                <button matSuffix mat-icon-button type="button" (click)="abrirUbicaciones(triggerUbicacion)" tabindex="-1">
                  <mat-icon class="text-secondary" style="font-size: 22px; width: 22px; height: 22px;">arrow_drop_down</mat-icon>
                </button>

                <mat-autocomplete #autoUbicacion="matAutocomplete"
                                  [displayWith]="displayFnUbicacion"
                                  (optionSelected)="seleccionarUbicacion($event)">
                  @for (u of ubicacionesFiltradas(); track u.idUbicacion) {
                    <mat-option [value]="u">
                      <div class="d-flex align-items-center justify-content-between w-100">
                        <span class="text-dark">{{ u.nombreubicacion }}</span>
                        @if (u.siglasubicacion) {
                          <small class="badge bg-light text-secondary border font-monospace ms-2">{{ u.siglasubicacion }}</small>
                        }
                      </div>
                    </mat-option>
                  }
                  @if (ubicacionesFiltradas().length === 0) {
                    <mat-option disabled>
                      <span class="text-muted small">No se encontraron ubicaciones coincidentes</span>
                    </mat-option>
                  }
                </mat-autocomplete>
              </mat-form-field>
              @if (form.get('idUbicacion')?.touched && form.get('idUbicacion')?.hasError('required')) {
                <small class="text-danger">La ubicación es obligatoria</small>
              }
            </div>

            <!-- RESPONSABLE (OPCIONAL) -->
            <div class="col-md-3">
              <label class="form-label small fw-bold text-muted">Responsable (Opcional)</label>
              <mat-form-field appearance="outline" class="w-100" subscriptSizing="dynamic">
                <input matInput formControlName="responsableDestino" placeholder="Ej. Christian Ordoñez" Mayusculas>
              </mat-form-field>
            </div>

            <!-- OBSERVACIONES -->
            <div class="col-12">
              <label class="form-label small fw-bold text-muted">Observaciones Generales</label>
              <mat-form-field appearance="outline" class="w-100" subscriptSizing="dynamic">
                <textarea matInput formControlName="observaciones" rows="2" placeholder="Detalles sobre las condiciones de entrega o justificación"></textarea>
              </mat-form-field>
            </div>

          </div>
        </div>

        <h6 class="text-muted fw-bold mb-3 small text-uppercase" style="letter-spacing: 1px;">Búsqueda de Equipos Físicos</h6>

        <div class="p-4 rounded-3 mb-4 border border-dashed bg-white">
          <label class="form-label small fw-bold text-muted">Buscar por Nombre, N° de Serie, N° de Inventario o SKU</label>
          <mat-form-field appearance="outline" class="w-100" subscriptSizing="dynamic">
            <mat-icon matPrefix class="text-primary me-2">search</mat-icon>
            <input type="text"
                   matInput
                   [formControl]="filtroCtrl"
                   [matAutocomplete]="auto"
                   placeholder="Escriba para buscar..."
                   (focus)="actualizarEquiposSilencioso()">

            <mat-autocomplete #auto="matAutocomplete" (optionSelected)="seleccionarProducto($event)">
              @if (cargandoEquipos) {
                <mat-option disabled class="text-center">
                  <div class="d-flex align-items-center justify-content-center text-muted py-2" style="height: 100%;">
                    <mat-spinner diameter="20" strokeWidth="2" class="me-3"></mat-spinner>
                    <span class="fst-italic">Cargando Catálogo de Equipos...</span>
                  </div>
                </mat-option>
              } @else {
                @for (item of (itemsFiltrados | async) ?? []; track item.producto.idProducto) {
                  <mat-option [value]="item">
                    <div class="d-flex justify-content-between align-items-center w-100">
                      <div>
                        <span class="fw-bold text-dark">{{ item.producto.nombreproducto }}</span>
                        <small class="text-muted ms-2">[Serie: {{ item.producto.serieproducto || 'S/N' }}] - [Inv: {{ item.producto.inventarioproducto || 'S/I' }}]</small>
                      </div>
                      <span class="badge bg-light text-dark border ms-2">Bodega: {{ item.bodega.nombrebodega }}</span>
                    </div>
                  </mat-option>
                }
              }
            </mat-autocomplete>
          </mat-form-field>
        </div>

        <div class="border rounded-3 overflow-hidden mb-4">
          <table mat-table [dataSource]="itemsSeleccionados()" class="w-100">

            <ng-container matColumnDef="producto">
              <th mat-header-cell *matHeaderCellDef class="bg-light text-dark fw-bold ps-3"> EQUIPO </th>
              <td mat-cell *matCellDef="let element" class="ps-4">
                <div class="d-flex align-items-center gap-3 py-2">
                  <div class="avatar-item">
                    {{ element.producto.nombreproducto.charAt(0) }}
                  </div>
                  <div>
                    <div class="fw-bold text-dark">{{ element.producto.nombreproducto }}</div>
                  </div>
                </div>
              </td>
            </ng-container>

            <ng-container matColumnDef="marca">
              <th mat-header-cell *matHeaderCellDef class="bg-light text-dark fw-bold"> MARCA </th>
              <td mat-cell *matCellDef="let element" class="py-2">
                {{ element.producto.modelo?.marca?.nombremarca || 'N/A' }}
              </td>
            </ng-container>

            <ng-container matColumnDef="modelo">
              <th mat-header-cell *matHeaderCellDef class="bg-light text-dark fw-bold"> MODELO </th>
              <td mat-cell *matCellDef="let element" class="py-2">
                {{ element.producto.modelo?.nombremodelo || 'N/A' }}
              </td>
            </ng-container>

            <ng-container matColumnDef="serie">
              <th mat-header-cell *matHeaderCellDef class="bg-light text-dark fw-bold"> SERIE </th>
              <td mat-cell *matCellDef="let element" class="py-2 font-monospace">
                {{ element.producto.serieproducto || 'S/N' }}
              </td>
            </ng-container>

            <ng-container matColumnDef="inventario">
              <th mat-header-cell *matHeaderCellDef class="bg-light text-dark fw-bold"> INVENTARIO </th>
              <td mat-cell *matCellDef="let element" class="py-2 font-monospace">
                {{ element.producto.inventarioproducto || 'S/I' }}
              </td>
            </ng-container>

            <ng-container matColumnDef="bodega">
              <th mat-header-cell *matHeaderCellDef class="bg-light text-dark fw-bold"> BODEGA DE SALIDA </th>
              <td mat-cell *matCellDef="let element" class="py-2">
                <span class="badge-pill bg-light text-info-emphasis ">{{ element.bodega.nombrebodega }}</span>
              </td>
            </ng-container>

            <ng-container matColumnDef="acciones">
              <th mat-header-cell *matHeaderCellDef class="bg-light text-center text-dark fw-bold">ACCIONES</th>
              <td mat-cell *matCellDef="let element; let i = index" class="text-center py-2">
                <button mat-icon-button class="btn-sm opacity-75 hover-opacity-100 action-btn delete" (click)="eliminarItem(i)">
                  <mat-icon>delete_outline</mat-icon>
                </button>
              </td>
            </ng-container>

            <tr mat-header-row *matHeaderRowDef="displayedColumns"></tr>
            <tr mat-row *matRowDef="let row; columns: displayedColumns;"></tr>

            <tr class="mat-row" *matNoDataRow>
              <td class="mat-cell text-center py-5 text-muted" colspan="7">
                <mat-icon style="font-size: 32px; width: 32px; height: 32px;" class="mb-2 opacity-50">devices</mat-icon>
                <p class="m-0 small">No ha seleccionado ningún equipo para esta asignación.</p>
              </td>
            </tr>
          </table>
        </div>

        <div class="d-flex justify-content-end gap-3 pt-3 border-top">
          <button mat-raised-button class="btn-confirm px-5 py-2 rounded-pill text-white" (click)="guardar()" [disabled]="guardando()">
            <mat-icon class="me-2">{{ esEdicion() ? 'save' : 'check_circle' }}</mat-icon>
            {{ guardando() ? 'GUARDANDO...' : (esEdicion() ? 'GUARDAR CAMBIOS' : 'REGISTRAR ASIGNACIÓN') }}
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
</file>

<file path="src/app/components/asignacion/asignacion-form/asignacion-form.component.ts">
import { Component, OnInit, inject, signal, computed, ChangeDetectorRef } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormBuilder, FormGroup, ReactiveFormsModule, Validators, FormControl } from '@angular/forms';
import { Router, RouterLink, ActivatedRoute } from '@angular/router';
import { MatCardModule } from '@angular/material/card';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatInputModule } from '@angular/material/input';
import { MatSelectModule } from '@angular/material/select';
import { MatButtonModule } from '@angular/material/button';
import { MatIconModule } from '@angular/material/icon';
import { MatTableModule } from '@angular/material/table';
import { MatAutocompleteModule } from '@angular/material/autocomplete';
import { MatProgressSpinner } from '@angular/material/progress-spinner';
import { MatTooltipModule } from '@angular/material/tooltip';
import { Observable, forkJoin } from 'rxjs';
import { startWith, map } from 'rxjs/operators';

import { AsignacionService } from '../../../services/asignacion.service';
import { TipoAsignacionService } from '../../../services/tipo-asignacion.service';
import { UbicacionService } from '../../../services/ubicacion.service';
import { InventarioService } from '../../../services/inventario.service';
import { AuthService } from '../../../services/auth.service';
import { Mensaje } from '../../../core/mensaje';
import { TipoAsignacion } from '../../../models/tipo-asignacion';
import { Ubicacion } from '../../../models/ubicacion';
import { AsignacionCreacionDTO } from '../../../models/asignacion';
import { MayusculasDirective } from '../../../core/directives/mayusculas.directive';

@Component({
  selector: 'app-asignacion-form',
  standalone: true,
  imports: [
    CommonModule, ReactiveFormsModule, MatCardModule, MatFormFieldModule,
    MatInputModule, MatSelectModule, MatButtonModule, MatIconModule,
    MatTableModule, MatAutocompleteModule, MatProgressSpinner, RouterLink,
    MatTooltipModule, MayusculasDirective
  ],
  templateUrl: './asignacion-form.component.html',
  styleUrls: ['./asignacion-form.component.css']
})
export class AsignacionFormComponent implements OnInit {

  private fb = inject(FormBuilder);
  private asignacionService = inject(AsignacionService);
  private tipoAsignacionService = inject(TipoAsignacionService);
  private ubicacionService = inject(UbicacionService);
  private inventarioService = inject(InventarioService);
  private authService = inject(AuthService);
  private mensaje = inject(Mensaje);
  private router = inject(Router);
  private route = inject(ActivatedRoute);
  private cdr = inject(ChangeDetectorRef);

  tiposAsignacion = signal<TipoAsignacion[]>([]);
  ubicaciones = signal<Ubicacion[]>([]);

  ubicacionFiltroCtrl = new FormControl<any>('');
  textoFiltroUbicacion = signal<string>('');

  ubicacionesFiltradas = computed(() => {
    const query = this.textoFiltroUbicacion().toLowerCase().trim();
    const list = this.ubicaciones();

    if (!query) {
      return list;
    }

    return list.filter(u =>
      (u.nombreubicacion && u.nombreubicacion.toLowerCase().includes(query)) ||
      (u.siglasubicacion && u.siglasubicacion.toLowerCase().includes(query))
    );
  });

  itemsDisponibles: any[] = [];
  itemsOriginalesEdicion: any[] = [];
  filtroCtrl = new FormControl('');
  itemsFiltrados!: Observable<any[]>;

  itemsSeleccionados = signal<any[]>([]);
  displayedColumns: string[] = ['producto', 'marca', 'modelo', 'serie', 'inventario', 'bodega', 'acciones'];

  guardando = signal<boolean>(false);
  cargandoEquipos: boolean = false;

  esEdicion = signal<boolean>(false);
  idAsignacion = signal<number | null>(null);
  numeroActa = signal<string>('');

  form: FormGroup = this.fb.group({
    idAsignacionTipo: [null, Validators.required],
    idUbicacion: [null, Validators.required],
    responsableDestino: [''],
    observaciones: ['']
  });

  ngOnInit(): void {
    this.tipoAsignacionService.listarActivos().subscribe(data => this.tiposAsignacion.set(data));

    this.cargarCatalogoUbicaciones();

    this.ubicacionFiltroCtrl.valueChanges.subscribe(val => {
      if (typeof val === 'string') {
        this.textoFiltroUbicacion.set(val);
        if (val.trim() === '') {
          this.form.get('idUbicacion')?.setValue(null);
        }
      } else if (val) {
        this.textoFiltroUbicacion.set('');
      }
    });

    this.cargarInventarioConsolidado(true);

    this.itemsFiltrados = this.filtroCtrl.valueChanges.pipe(
      startWith(''),
      map(val => this.filtrarItems(val || ''))
    );

    const idParam = this.route.snapshot.paramMap.get('id');
    if (idParam) {
      const id = +idParam;
      this.idAsignacion.set(id);
      this.esEdicion.set(true);
      this.cargarDatosEdicion(id);
    }
  }

  cargarCatalogoUbicaciones() {
    const req$ = typeof (this.ubicacionService as any).getUbicacionesActivas === 'function'
      ? this.ubicacionService.getUbicacionesActivas()
      : this.ubicacionService.getUbicaciones();

    req$.subscribe({
      next: (data: Ubicacion[]) => {
        const activas = data.filter(u => u.activo !== false);
        this.ubicaciones.set(activas);

        if (this.esEdicion() && this.form.get('idUbicacion')?.value) {
          const uEncontrada = activas.find(u => u.idUbicacion === this.form.get('idUbicacion')?.value);
          if (uEncontrada) {
            this.ubicacionFiltroCtrl.setValue(uEncontrada, { emitEvent: false });
          }
        }
        this.cdr.detectChanges();
      },
      error: (err: any) => {
        console.error('Error al cargar ubicaciones:', err);
      }
    });
  }

  abrirUbicaciones(trigger: any) {
    if (typeof this.ubicacionFiltroCtrl.value !== 'string') {
      this.textoFiltroUbicacion.set('');
    }
    trigger.openPanel();
  }

  displayFnUbicacion = (item: any): string => {
    if (!item) return '';
    if (typeof item === 'string') return item;
    return item.siglasubicacion
      ? `${item.nombreubicacion} (${item.siglasubicacion})`
      : item.nombreubicacion || '';
  };

  seleccionarUbicacion(event: any) {
    const u: Ubicacion = event.option.value;
    if (u && u.idUbicacion) {
      this.form.get('idUbicacion')?.setValue(u.idUbicacion);
      this.textoFiltroUbicacion.set('');
    } else {
      this.limpiarUbicacion();
    }
  }

  limpiarUbicacion() {
    this.ubicacionFiltroCtrl.setValue('');
    this.form.get('idUbicacion')?.setValue(null);
    this.textoFiltroUbicacion.set('');
    this.form.get('idUbicacion')?.markAsTouched();
  }

  cargarDatosEdicion(id: number) {
    forkJoin({
      asignacion: this.asignacionService.obtenerPorId(id),
      detalles: this.asignacionService.listarDetalles(id)
    }).subscribe({
      next: ({ asignacion, detalles }) => {
        if (asignacion.estado === 'DEVOLUCION TOTAL') {
          this.mensaje.open('Solo se pueden editar asignaciones en estado REGISTRADA', 'warning');
          this.router.navigate(['/asignaciones']);
          return;
        }

        this.numeroActa.set(asignacion.numeroActa);
        this.form.patchValue({
          idAsignacionTipo: asignacion.tipoAsignacion.idAsignacionTipo,
          idUbicacion: asignacion.ubicacion?.idUbicacion,
          responsableDestino: asignacion.responsableDestino || '',
          observaciones: asignacion.observaciones
        });

        if (asignacion.ubicacion) {
          this.ubicacionFiltroCtrl.setValue(asignacion.ubicacion, { emitEvent: false });
        }

        const itemsMapeados = detalles.map(d => ({
          producto: d.producto,
          bodega: d.bodegaOrigen,
          cantidad_actual: 1
        }));

        this.itemsOriginalesEdicion = [...itemsMapeados];
        this.itemsSeleccionados.set(itemsMapeados);
        this.fusionarItemsPropiosEnDisponibles();
      },
      error: () => {
        this.mensaje.open('Error al cargar la información de la asignación', 'error');
        this.router.navigate(['/asignaciones']);
      }
    });
  }

  private fusionarItemsPropiosEnDisponibles() {
    if (!this.esEdicion() || this.itemsOriginalesEdicion.length === 0) return;

    this.itemsOriginalesEdicion.forEach(itemActa => {
      const existe = this.itemsDisponibles.some(
        disp => disp.producto.idProducto === itemActa.producto.idProducto
      );
      if (!existe) {
        this.itemsDisponibles.push(itemActa);
      }
    });
    this.filtroCtrl.setValue(this.filtroCtrl.value, { emitEvent: true });
    this.cdr.detectChanges();
  }

  cargarInventarioConsolidado(mostrarSpinner: boolean = true) {
    if (mostrarSpinner) {
      this.cargandoEquipos = true;
      this.cdr.detectChanges();
    }

    this.inventarioService.listarInventarioConsolidado().subscribe({
      next: (inv) => {
        this.itemsDisponibles = inv.filter((i: any) => {
          const categoria = (i.producto?.categoria?.nombrecategoria || '').toUpperCase().trim();
          return !i.producto.esGenerico && i.cantidad_actual > 0 && !categoria.includes('MATERIALES');
        });
        this.fusionarItemsPropiosEnDisponibles();
        this.cargandoEquipos = false;
        this.filtroCtrl.setValue(this.filtroCtrl.value, { emitEvent: true });
        this.cdr.detectChanges();
      },
      error: (err) => {
        console.error('Error cargando inventario consolidado:', err);
        this.cargandoEquipos = false;
        this.cdr.detectChanges();
      }
    });
  }

  actualizarEquiposSilencioso() {
    if (this.cargandoEquipos) return;
    this.cargarInventarioConsolidado(this.itemsDisponibles.length === 0);
  }

  private filtrarItems(query: string): any[] {
    const q = (typeof query === 'string' ? query : '').toLowerCase().trim();
    if (!q) return this.itemsDisponibles.slice(0, 100);

    return this.itemsDisponibles.filter(item => {
      const p = item.producto;
      const texto = (
        p.nombreproducto + ' ' +
        (p.skuproducto || '') + ' ' +
        (p.serieproducto || '') + ' ' +
        (p.inventarioproducto || '') + ' ' +
        (p.modelo?.nombremodelo || '') + ' ' +
        (p.modelo?.marca?.nombremarca || '')
      ).toLowerCase();
      return texto.includes(q);
    }).slice(0, 100);
  }

  seleccionarProducto(event: any) {
    const invItem = event.option.value;

    const yaAgregado = this.itemsSeleccionados().some(i => i.producto.idProducto === invItem.producto.idProducto);
    if (yaAgregado) {
      this.mensaje.open('Este equipo ya está en la lista', 'warning');
      this.filtroCtrl.setValue('');
      return;
    }

    this.itemsSeleccionados.update(list => [...list, invItem]);
    this.filtroCtrl.setValue('');
  }

  eliminarItem(index: number) {
    this.itemsSeleccionados.update(list => list.filter((_, i) => i !== index));
  }

  guardar() {
    if (this.form.invalid) {
      this.form.markAllAsTouched();
      this.ubicacionFiltroCtrl.markAsTouched();
      this.mensaje.open('Complete los datos obligatorios', 'warning');
      return;
    }
    if (this.itemsSeleccionados().length === 0) {
      this.mensaje.open('Debe seleccionar al menos un equipo', 'warning');
      return;
    }

    this.guardando.set(true);

    const dto: AsignacionCreacionDTO = {
      idAsignacionTipo: this.form.value.idAsignacionTipo,
      idUbicacion: this.form.value.idUbicacion,
      responsableDestino: this.form.value.responsableDestino?.trim() || '',
      observaciones: this.form.value.observaciones,
      idUsuario: this.authService.getIdUsuarioActual(),
      items: this.itemsSeleccionados().map(i => ({
        idProducto: i.producto.idProducto,
        idBodegaOrigen: i.bodega.idBodega
      }))
    };

    if (this.esEdicion() && this.idAsignacion()) {
      this.asignacionService.actualizarAsignacion(this.idAsignacion()!, dto).subscribe({
        next: (asignacion) => {
          this.mensaje.open(`Asignación Acta N° ${asignacion.numeroActa} actualizada correctamente`, 'exito');
          this.guardando.set(false);
          this.router.navigate(['/asignaciones']);
        },
        error: (err) => {
          this.mensaje.open(err.error?.mensaje || 'Error al actualizar la asignación', 'error');
          this.guardando.set(false);
        }
      });
    } else {
      this.asignacionService.crearAsignacion(dto).subscribe({
        next: (creada) => {
          this.mensaje.open(`Asignación registrada con éxito (Acta N° ${creada.numeroActa})`, 'exito');
          this.guardando.set(false);
          this.router.navigate(['/asignaciones']);
        },
        error: (err) => {
          this.mensaje.open(err.error?.mensaje || 'Error al guardar la asignación', 'error');
          this.guardando.set(false);
        }
      });
    }
  }
}
