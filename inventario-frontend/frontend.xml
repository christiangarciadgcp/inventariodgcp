<file path="src/app/components/asignacion/asignacion-list/asignacion-list.component.html">
<div class="container-wide px-5 mt-4">

  <!-- CABECERA SUPERIOR -->
  <div class="d-flex align-items-center gap-3 mb-2 px-2">
    <button mat-icon-button class="bg-white shadow-sm text-dark" routerLink="/dashboard">
      <mat-icon style="margin-bottom: 5px;">arrow_back</mat-icon>
    </button>
    <div>
      <h6 class="text-uppercase text-muted mb-1" style="font-size: 0.8rem; letter-spacing: 1px;">Control de Equipos</h6>
      <h2 class="fw-bold text-dark m-0">Gestión de Asignaciones</h2>
    </div>
  </div>

  <!-- PESTAÑAS, BOTÓN NUEVO Y BUSCADOR EN LA MISMA FILA -->
  <div class="tabs-header-container d-flex flex-wrap justify-content-between align-items-center gap-3 mb-1 px-2">

    <!-- PESTAÑAS (Izquierda) -->
    <div class="d-flex flex-wrap align-items-center gap-2">
      <button type="button" class="tab-pill-btn" [class.active]="tabActiva() === 'REGISTRADAS'" (click)="cambiarPestana('REGISTRADAS')">
        <mat-icon class="me-1 icon-tab">pending_actions</mat-icon>
        Registradas
        <span class="tab-badge ms-2">{{ conteoRegistradas() }}</span>
      </button>

      <button type="button" class="tab-pill-btn" [class.active]="tabActiva() === 'ASIGNADAS'" (click)="cambiarPestana('ASIGNADAS')">
        <mat-icon class="me-1 icon-tab">verified</mat-icon>
        Asignadas
        <span class="tab-badge ms-2">{{ conteoAsignadas() }}</span>
      </button>

      <button type="button" class="tab-pill-btn" [class.active]="tabActiva() === 'DEVOLUCIONES'" (click)="cambiarPestana('DEVOLUCIONES')">
        <mat-icon class="me-1 icon-tab">assignment_return</mat-icon>
        Devoluciones
        <span class="tab-badge ms-2">{{ conteoDevoluciones() }}</span>
      </button>

      <button type="button" class="tab-pill-btn" [class.active]="tabActiva() === 'TODAS'" (click)="cambiarPestana('TODAS')">
        <mat-icon class="me-1 icon-tab">list_alt</mat-icon>
        Todas
        <span class="tab-badge ms-2">{{ asignaciones().length }}</span>
      </button>
    </div>

    <!-- BOTÓN NUEVA ASIGNACIÓN Y BUSCADOR (Derecha) -->
    <div class="d-flex flex-wrap align-items-center gap-3">
      <button mat-raised-button class="rounded-pill px-4 btn-nuevo m-0" routerLink="/asignaciones/nueva">
        <mat-icon class="me-2">add_task</mat-icon> Nueva Asignación
      </button>

      <div class="search-elegant m-0" style="width: 280px;">
        <input type="text" class="search-input" (keyup)="applyFilter($event)" placeholder="Buscar..." autocomplete="off">
        <div class="search-btn-circle">
          <mat-icon>search</mat-icon>
        </div>
      </div>
    </div>

  </div>

  <!-- TARJETA CON LA TABLA -->
  <mat-card class="custom-card mb-5">
    @if (cargando()) {
      <div class="d-flex flex-column justify-content-center align-items-center py-5">
        <mat-spinner diameter="50" strokeWidth="5" color="primary"></mat-spinner>
        <h6 class="mt-2 text-dark fw-bold m-0" style="letter-spacing: 1px;">Cargando asignaciones...</h6>
      </div>
    } @else {
      <table mat-table [dataSource]="dataSource" matSort class="w-100">

        <!-- N° ACTA -->
        <ng-container matColumnDef="acta">
          <th mat-header-cell *matHeaderCellDef mat-sort-header class="text-center"> N° ACTA </th>
          <td mat-cell *matCellDef="let element" class="text-center py-2">
            <span class="badge-soft badge-acta-gris">
              {{ element.numeroActa }}
            </span>
          </td>
        </ng-container>

        <!-- FECHA -->
        <ng-container matColumnDef="fecha">
          <th mat-header-cell *matHeaderCellDef mat-sort-header class="text-center"> FECHA </th>
          <td mat-cell *matCellDef="let element" class="text-center py-2">
            <span class="text-dark fw-medium d-block">{{ element.fechaAsignacion | date:'dd/MM/yyyy' }}</span>
            <small class="text-muted">{{ element.fechaAsignacion | date:'h:mm a' }}</small>
          </td>
        </ng-container>

        <!-- REALIZADO POR -->
        <ng-container matColumnDef="realizado">
          <th mat-header-cell *matHeaderCellDef mat-sort-header class="text-center"> Realizado por </th>
          <td mat-cell *matCellDef="let element" class="text-center py-2">
            <div class="fw-bold text-dark">
              {{ utils.formatearNombre(element.usuarioCreacion.nombreusuario) }}
            </div>
          </td>
        </ng-container>

        <!-- TIPO -->
        <ng-container matColumnDef="tipo">
          <th mat-header-cell *matHeaderCellDef mat-sort-header class="text-center"> TIPO </th>
          <td mat-cell *matCellDef="let element" class="text-center py-2">
            <span class="badge-soft" [ngClass]="obtenerClaseTipo(element.tipoAsignacion?.nombre)">
              {{ element.tipoAsignacion?.nombre }}
            </span>
          </td>
        </ng-container>

        <!-- RESPONSABLE / DESTINO -->
        <ng-container matColumnDef="responsable">
          <th mat-header-cell *matHeaderCellDef mat-sort-header class="text-center"> UBICACIÓN / RESPONSABLE </th>
          <td mat-cell *matCellDef="let element" class="text-center py-2">
            <div class="fw-bold text-dark">
              {{ element.ubicacion?.nombreubicacion || 'Sin ubicación' }}
            </div>
            @if (element.responsableDestino) {
              <small class="text-muted d-block mt-1">
                <mat-icon style="font-size: 13px; width: 13px; height: 13px; vertical-align: middle;">person</mat-icon>
                {{ element.responsableDestino }}
              </small>
            }
          </td>
        </ng-container>


        <!-- ESTADO -->
        <ng-container matColumnDef="estado">
          <th mat-header-cell *matHeaderCellDef mat-sort-header class="text-center"> ESTADO </th>
          <td mat-cell *matCellDef="let element" class="text-center py-2">
            <span class="badge-soft" [ngClass]="obtenerClaseEstado(element.estado)">
              {{ obtenerTextoEstado(element.estado) }}
            </span>
          </td>
        </ng-container>

        <!-- ACCIONES -->
        <ng-container matColumnDef="acciones">
          <th mat-header-cell *matHeaderCellDef class="text-center pe-4"> ACCIONES </th>
          <td mat-cell *matCellDef="let element" class="text-center pe-4 py-2 col-acciones">

            <!-- VER DETALLES -->
            <button mat-icon-button class="action-btn text-dark" matTooltip="Ver Historial / Gestionar" (click)="verDetalleHistorial(element)">
              <mat-icon>format_list_bulleted</mat-icon>
            </button>

            <!-- EDITAR ASIGNACION -->
            @if (element.estado !== 'DEVOLUCION TOTAL') {
              <button mat-icon-button class="action-btn edit-color" matTooltip="Editar Asignación" [routerLink]="['/asignaciones/editar', element.idAsignacion]">
                <mat-icon>edit</mat-icon>
              </button>
            }

            <!-- ACTA DE MOVIMIENTO DE EQUIPLO -->
            <button mat-icon-button class="action-btn text-info-emphasis" matTooltip="Ver / Imprimir Acta" (click)="verActa(element)">
              <mat-icon>picture_as_pdf</mat-icon>
            </button>

            <!-- DEVOLUCION DE EQUIPO -->
            @if (element.estado === 'ASIGNADA' || element.estado === 'DEVOLUCION PARCIAL') {
              <button mat-icon-button class="action-btn text-primary" matTooltip="Devolución de Equipos" (click)="abrirDevolucion(element)">
                <mat-icon>reply_all</mat-icon>
              </button>
            }
          </td>
        </ng-container>

        <tr mat-header-row *matHeaderRowDef="displayedColumns"></tr>
        <tr mat-row *matRowDef="let row; columns: displayedColumns;" class="hover-row"></tr>

        <tr class="mat-row" *matNoDataRow>
          <td class="mat-cell text-center py-5 text-muted" colspan="7">
            <mat-icon style="font-size: 40px; width: 40px; height: 40px;" class="mb-2">assignment_late</mat-icon>
            <p class="m-0">No se encontraron asignaciones</p>
          </td>
        </tr>
      </table>
    }
    <mat-paginator [pageSizeOptions]="[25, 50, 100]" showFirstLastButtons></mat-paginator>
  </mat-card>
</div>
</file>

